@page
@model ZfsDashboard.Pages.Pools.IndexModel
@{
  ViewData["Title"] = "Pools";
  var header = new PageHeaderViewModel(
      Icon: "bi-hdd-stack",
      Title: "Pools",
      Subtitle: $"All ZFS storage pools - {Model.Pools.Count} total");
}

<partial name="_PageHeader" model="header" />

@if (Model.Pools.Count == 0)
{
  <div class="alert alert-secondary">
    <i class="bi bi-info-circle me-1"></i>No pools found.
  </div>
}
else
{
  <p class="small text-body-secondary mb-3">
    <i class="bi bi-mouse2 me-1"></i>Right-click a card to copy commands.
  </p>
  <div class="row row-cols-1 row-cols-lg-2 g-4 mb-4">
    @foreach (var p in Model.Pools)
    {
      @* Fragmentation thresholds differ from the capacity thresholds. *@
      var fragCss = p.Fragmentation > 75 ? "text-danger" : p.Fragmentation > 50 ? "text-warning" : "";
      <div class="col">
        <article class="card bg-surface h-100" data-command-context="@Model.ContextCommands.Id" data-command-pool="@p.Name">
          <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
              <div class="d-flex align-items-center gap-2">
                <h5 class="card-title d-flex align-items-center gap-2 text-break mb-0">
                  <i class="bi bi-hdd-stack text-info"></i>
                  <a asp-page="Details" asp-route-name="@p.Name" class="text-decoration-none text-info">@p.Name</a>
                </h5>
                @if (p.Encrypted)
                {
                  <span class="text-warning flex-shrink-0" tabindex="0" data-bs-toggle="tooltip" data-bs-title="Root dataset encrypted (@p.EncryptionAlgorithm)">
                    <i class="bi bi-lock-fill"></i>
                    <span class="visually-hidden">Encrypted</span>
                  </span>
                }
                @if (p.HasErrors)
                {
                  <span class="text-danger flex-shrink-0" tabindex="0" data-bs-toggle="tooltip" data-bs-title="Read: @p.ErrorsRead | Write: @p.ErrorsWrite | Checksum: @p.ErrorsChecksum">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span class="visually-hidden">Pool errors</span>
                  </span>
                }
                else
                {
                  <span class="text-success small flex-shrink-0" tabindex="0" data-bs-toggle="tooltip" data-bs-title="No pool errors">
                    <i class="bi bi-check-circle"></i>
                    <span class="visually-hidden">No pool errors</span>
                  </span>
                }
              </div>
              <span class="badge @p.Health.ToStatusBadgeCss() border"><span class="visually-hidden">Health: </span>@p.Health</span>
            </div>

            <dl class="row row-cols-2 row-cols-sm-4 g-2 small mb-3">
              <div class="col">
                <dt class="text-body-secondary fw-normal">Size (raw)</dt>
                <dd class="fw-semibold mb-0">@p.Size.FormatBytes()</dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Usable</dt>
                <dd class="fw-semibold mb-0">@p.UsableSize.FormatBytes()</dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Used</dt>
                <dd class="fw-semibold mb-0">@p.UsableUsed.FormatBytes()</dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Free</dt>
                <dd class="fw-semibold mb-0">@p.UsableAvail.FormatBytes()</dd>
              </div>
            </dl>
            <div class="small border-bottom border-secondary-subtle pb-3 mb-3">
              <div class="text-body-secondary">Capacity</div>
              <partial name="_CapacityBar" model="new CapacityBarViewModel(p.UsagePercent)" />
            </div>

            <dl class="row row-cols-2 row-cols-sm-3 g-2 small mb-0">
              <div class="col">
                <dt class="text-body-secondary fw-normal">VDEV TYPE</dt>
                <dd class="mb-0"><span class="badge bg-secondary">@(string.IsNullOrEmpty(p.VdevType) ? "\u2013" : p.VdevType)</span></dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Ashift</dt>
                <dd class="mb-0">@p.Ashift</dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Frag</dt>
                <dd class="mb-0 @fragCss">@p.Fragmentation%</dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Compression</dt>
                <dd class="mb-0">@p.Compression (@p.CompRatio)</dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Dedup</dt>
                <dd class="mb-0">@p.Dedup</dd>
              </div>
              <div class="col">
                <dt class="text-body-secondary fw-normal">Devices</dt>
                <dd class="mb-0">
                  <span tabindex="0" data-bs-toggle="tooltip" data-bs-title="@p.DataDevices.Count data, @p.SpecialDevices.Count special, @p.CacheDevices.Count cache, @p.LogDevices.Count log, @p.SpareDevices.Count spare">
                    @p.DataDevices.Count
                    @if (p.SpecialDevices.Count > 0)
                    {
                      <span class="text-body-secondary">+ @p.SpecialDevices.Count</span>
                    }
                    @if (p.CacheDevices.Count > 0)
                    {
                      <span class="text-body-secondary">+ @p.CacheDevices.Count</span>
                    }
                    @if (p.LogDevices.Count > 0)
                    {
                      <span class="text-body-secondary">+ @p.LogDevices.Count</span>
                    }
                  </span>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    }
  </div>
}

<div class="d-flex justify-content-center mb-4">
  <partial name="_CommandMenu" model="Model.GlobalCommands" />
</div>

<partial name="_CommandMenu" model="Model.ContextCommands" />
