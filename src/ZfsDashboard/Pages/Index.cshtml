@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div id="dashboard" data-live-url="@Url.Page("/Index", "Live")">
    <div class="d-flex justify-content-between align-items-center mb-1 pb-2 border-bottom border-secondary">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-grid-1x2 me-2 text-info"></i>System Dashboard
        </h3>
        <span class="badge bg-body-tertiary text-body-secondary border">
            <i class="bi bi-clock me-1"></i><span id="sysUptime">@Model.Live.Uptime</span>
        </span>
    </div>
    <p class="text-body-secondary mb-4">Overview of system resources and ZFS pools</p>

    <div class="row g-4">
        <div class="col-lg-6">
            <partial name="/Pages/Dashboard/_NetworkCard.cshtml" />
            <partial name="/Pages/Dashboard/_CpuCard.cshtml" model="Model.Cpu" />
            <partial name="/Pages/Dashboard/_MemoryCard.cshtml" model="Model.Live.Memory" />
            <partial name="/Pages/Dashboard/_ArcCard.cshtml" model="Model.Live.Arc" />
        </div>
        <div class="col-lg-6">
            <partial name="/Pages/Dashboard/_DiskIoCard.cshtml" />
            <partial name="/Pages/Dashboard/_PoolOverview.cshtml" model="Model.Pools" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js"></script>
}
