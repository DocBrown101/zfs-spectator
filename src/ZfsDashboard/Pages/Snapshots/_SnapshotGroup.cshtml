@model SnapshotGroupViewModel
<div class="card mb-4">
    <div class="card-body bg-surface">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-camera text-info"></i>
            <a asp-page="/Datasets/Details" asp-route-name="@Model.DatasetName" class="text-info text-decoration-none font-monospace">@Model.DatasetName</a>
            <span class="badge bg-body-tertiary text-body-secondary border ms-auto">@Model.Rows.Count</span>
        </h5>
        <partial name="_SnapshotTable" model="Model" />
    </div>
</div>
