@page
@model ZfsDashboard.Pages.Snapshots.IndexModel
@{
    ViewData["Title"] = "Snapshots";
}

<h3 class="fw-bold mb-1 pb-2 border-bottom border-secondary">
    <i class="bi bi-camera me-2 text-info"></i>Snapshots
</h3>
<p class="text-body-secondary mb-4">All ZFS snapshots grouped by dataset &mdash; @Model.Snapshots.TotalCount total</p>

@if (Model.Snapshots.TotalCount == 0)
{
    <div class="alert alert-secondary">
        <i class="bi bi-info-circle me-1"></i>No snapshots found.
    </div>
}

@foreach (var group in Model.Snapshots.Groups)
{
    <partial name="_SnapshotGroup" model="group" />
}

<partial name="_CommandSuggestions" model="Model.Suggestions" />
