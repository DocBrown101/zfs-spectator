@model IReadOnlyList<KeyValueRowViewModel>
@foreach (var row in Model)
{
    <div class="row py-2 small @(row.Last ? "" : "border-bottom border-secondary")">
        <div class="col-5 text-body-secondary">@row.Label</div>
        <div class="col-7 fw-semibold" id="@row.ElementId">@row.Value</div>
    </div>
}
