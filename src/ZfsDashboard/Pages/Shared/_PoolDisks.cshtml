@model List<DiskIoRateInfo>
@if (Model.Count == 0)
{
    <tr><td colspan="6" class="text-body-secondary">No disk data</td></tr>
}
else
{
    @foreach (var d in Model)
    {
        var uc = d.UtilizationPct > 80 ? "text-danger" : d.UtilizationPct > 50 ? "text-warning" : "";
        var latR = d.ReadLatencyMs <= 0 ? "\u2013" : d.ReadLatencyMs < 10 ? d.ReadLatencyMs.ToString("F2") : d.ReadLatencyMs.ToString("F1");
        var latW = d.WriteLatencyMs <= 0 ? "\u2013" : d.WriteLatencyMs < 10 ? d.WriteLatencyMs.ToString("F2") : d.WriteLatencyMs.ToString("F1");
        <tr class="border-bottom border-secondary">
            <td class="fw-semibold font-monospace">@d.Device</td>
            <td><span class="badge bg-secondary">@(string.IsNullOrEmpty(d.VdevType) ? "\u2013" : d.VdevType)</span></td>
            <td class="text-end font-monospace">@Math.Round(d.QueueDepth)</td>
            <td class="text-end font-monospace">@latR</td>
            <td class="text-end font-monospace">@latW</td>
            <td class="text-end font-monospace @uc">@d.UtilizationPct.ToString("F1")%</td>
        </tr>
    }
}
