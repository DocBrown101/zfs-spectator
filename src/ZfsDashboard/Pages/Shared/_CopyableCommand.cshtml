@model CopyableCommandViewModel
<div class="cmd-block">
    <pre class="bg-body-tertiary text-body border p-2 rounded-2 @(Model.Compact ? "small" : "")"><code>@Model.Command</code></pre>
    <button type="button" class="btn btn-sm btn-outline-secondary btn-copy" data-bs-toggle="tooltip" data-bs-title="@Model.Tooltip" aria-label="@Model.Tooltip">
        <i class="bi bi-clipboard"></i>
    </button>
</div>

@{
    const string scriptName = "CopyableCommand.js";
    const string scriptKey = "__" + scriptName;
    var renderScript = Context.Items.TryAdd(scriptKey, true);
}

@if (renderScript)
{
    <script src="~/js/shared/@scriptName"></script>
}
