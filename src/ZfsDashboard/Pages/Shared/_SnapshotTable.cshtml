@model SnapshotTableViewModel
@if (Model.Rows.Count == 0)
{
    <span class="text-body-secondary small">@Model.EmptyMessage</span>
}
else
{
    <div class="accordion" id="@Model.AccordionId">
        @foreach (var snapshot in Model.Rows)
        {
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed flex-wrap row-gap-1"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@snapshot.CollapseId"
                            aria-expanded="false"
                            aria-controls="@snapshot.CollapseId">
                        <span class="font-monospace small">@@@snapshot.Name</span>
                        <span class="ms-auto d-flex gap-3 text-end">
                            <span class="small text-body-secondary">Used <span class="text-body">@snapshot.Used</span></span>
                            <span class="small text-body-secondary">Refer <span class="text-body">@snapshot.Referenced</span></span>
                            <span class="small text-body-secondary">Created <span class="text-body">@snapshot.Created</span></span>
                        </span>
                    </button>
                </h2>
                <div id="@snapshot.CollapseId" class="accordion-collapse collapse" data-bs-parent="#@Model.AccordionId">
                    <div class="accordion-body">
                        <div class="small text-body-secondary mb-1">Rollback</div>
                        <div class="mb-1">
                            <partial name="_CopyableCommand" model="snapshot.RollbackCommand" />
                        </div>
                        <div class="small text-danger-emphasis mt-3 mb-1">Destroy</div>
                        <partial name="_CopyableCommand" model="snapshot.DestroyCommand" />
                    </div>
                </div>
            </div>
        }
    </div>
}
