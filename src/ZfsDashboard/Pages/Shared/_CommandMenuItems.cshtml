@model IReadOnlyList<CommandMenuItemViewModel>
@for (var index = 0; index < Model.Count; index++)
{
  var item = Model[index];
  @if (item.IsDangerous && (index == 0 || !Model[index - 1].IsDangerous))
  {
    <li>
      <hr class="dropdown-divider" />
    </li>
  }
  <li>
    <button type="button" class="dropdown-item command-menu-copy @(item.IsDangerous ? "text-danger-emphasis" : "")" data-command-template="@item.Suggestion.ZfsCommand">
      <span class="d-flex align-items-center gap-2">
        <i class="bi @item.Icon"></i>
        <span data-description-template="@item.Suggestion.Description">@item.Suggestion.Description</span>
        <i class="bi bi-clipboard ms-auto text-body-secondary"></i>
      </span>
      <code class="command-menu-preview text-body-secondary" data-command-preview>@item.Suggestion.ZfsCommand</code>
    </button>
  </li>
}

@if (Model.Any(item => item.Suggestion.NixOsConfig is not null))
{
  <li>
    <hr class="dropdown-divider" />
  </li>
  <li>
    <h6 class="dropdown-header"><i class="bi bi-snow me-1"></i>NixOS alternatives</h6>
  </li>
  @foreach (var suggestion in Model.Select(item => item.Suggestion).Where(suggestion => suggestion.NixOsConfig is not null))
  {
    <li>
      <button type="button" class="dropdown-item command-menu-copy" data-command-template="@suggestion.NixOsConfig">
        <span class="d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-code"></i>
          <span data-description-template="@suggestion.Description">@suggestion.Description</span>
          <i class="bi bi-clipboard ms-auto text-body-secondary"></i>
        </span>
        <small class="command-menu-preview text-body-secondary">Copy declarative configuration</small>
      </button>
    </li>
  }
}
