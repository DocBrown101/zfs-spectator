@page
@model ZfsDashboard.Pages.Datasets.DetailsModel
@{
  var ds = Model.Dataset!;
  ViewData["Title"] = $"Dataset: {ds.Name}";

  var header = new PageHeaderViewModel(
      Icon: "bi-folder2",
      Title: ds.Name,
      Subtitle: "Dataset details and snapshots",
      TitleIcon: ds.Encrypted
          ? new("bi-lock-fill text-info ms-1", ds.EncryptionAlgorithm)
          : null,
      StatusBadge: !ds.Mounted
          ? new("unmounted", "text-bg-secondary ms-2")
          : null);
}

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><a asp-page="Index">Datasets</a></li>
    <li class="breadcrumb-item active font-monospace">@ds.Name</li>
  </ol>
</nav>

<partial name="_PageHeader" model="header" />

<div class="row g-4 mb-4">
  <div class="col-lg-6 d-flex flex-column gap-4">
    <div class="card bg-surface flex-grow-1">
      <div class="card-body">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
          <i class="bi bi-pie-chart text-info"></i>
          Capacity
        </h5>
        <div class="mb-3">
          <partial name="_CapacityBar" model="new CapacityBarViewModel(ds.UsagePercent, CapacityBarSize.Regular, ShowPercentage: false)" />
        </div>
        <div class="row g-3 small">
          <div class="col-6">
            <div class="text-body-secondary">Used</div>
            <div class="fw-semibold">@ds.Used.FormatBytes()</div>
          </div>
          <div class="col-6">
            <div class="text-body-secondary">Available</div>
            <div class="fw-semibold">@ds.Avail.FormatBytes()</div>
          </div>
          <div class="col-6">
            <div class="text-body-secondary">Referenced</div>
            <div class="fw-semibold">@ds.Refer.FormatBytes()</div>
          </div>
          @if (ds.UsedBySnapshots > 0)
          {
            <div class="col-6">
              <div class="text-body-secondary">Snapshots</div>
              <div class="fw-semibold">@ds.UsedBySnapshots.FormatBytes()</div>
            </div>
          }
        </div>
      </div>
    </div>
    <div class="card bg-surface">
      <div class="card-body">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
          <i class="bi bi-camera text-info"></i>
          Snapshots
          <span class="badge bg-body-tertiary text-body-secondary border ms-auto">@Model.SnapshotGroup.Rows.Count</span>
        </h5>
        <partial name="_SnapshotTable" model="Model.SnapshotGroup" />
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card bg-surface h-100">
      <div class="card-body">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
          <i class="bi bi-gear text-info"></i>
          Properties
        </h5>
        <div class="row">
          <div class="col-xl-6">
            <partial name="_KeyValueRows" model="@(new KeyValueRowViewModel[]
              {
                new("Compression", $"{ds.Compression} ({ds.CompRatio})", ValueCss: "fw-semibold"),
                new("Record Size", ds.RecordSize > 0 ? ds.RecordSize.FormatBytes() : "inherit", ValueCss: "fw-semibold"),
                new("Dedup", ds.Dedup, ValueCss: "fw-semibold"),
                new("Sync", ds.Sync, ValueCss: "fw-semibold"),
                new("Case Sensitivity", ds.CaseSensitivity, ValueCss: "fw-semibold"),
              })" />
          </div>
          <div class="col-xl-6">
            <partial name="_KeyValueRows" model="@(new KeyValueRowViewModel[]
              {
                new("Mountpoint", ds.Mountpoint, ValueCss: "fw-semibold text-break"),
                new("CanMount", ds.CanMount, ValueCss: "fw-semibold"),
                new("Quota", ds.Quota.FormatBytesOrNone(), ValueCss: "fw-semibold"),
                new("RefQuota", ds.RefQuota.FormatBytesOrNone(), ValueCss: "fw-semibold"),
                new("Refreservation", ds.Refreservation.FormatBytesOrNone(), ValueCss: "fw-semibold"),
              })" />
          </div>
        </div>
        @if (Model.Encryption is { } encryption)
        {
          <partial name="_EncryptionDetails" model="encryption" />
        }
        @if (!string.IsNullOrEmpty(ds.Comment))
        {
          <div class="mt-2 small"><strong>Comment:</strong> @ds.Comment</div>
        }
      </div>
    </div>
  </div>
</div>

<partial name="_CommandSuggestions" model="new CommandSuggestionsViewModel(Model.Suggestions)" />
