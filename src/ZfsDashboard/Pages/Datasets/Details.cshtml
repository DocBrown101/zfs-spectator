@page
@model ZfsDashboard.Pages.Datasets.DetailsModel
@{
    var ds = Model.Dataset!;
    ViewData["Title"] = $"Dataset: {ds.Name}";

    var header = new PageHeaderViewModel(
        Icon: "bi-folder2",
        Title: ds.Name,
        Subtitle: "Dataset details and snapshots",
        TitleIcon: ds.Encrypted
            ? new("bi-lock-fill text-info ms-1", ds.EncryptionAlgorithm)
            : null,
        StatusBadge: !ds.Mounted
            ? new("unmounted", "text-bg-secondary ms-2")
            : null);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-page="Index">Datasets</a></li>
        <li class="breadcrumb-item active font-monospace">@ds.Name</li>
    </ol>
</nav>

<partial name="_PageHeader" model="header" />

@* ── Capacity ────────────────────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-body bg-surface">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-pie-chart text-info"></i>
            Capacity
        </h5>
        <div class="mb-3">
            <partial name="_CapacityBar" model="new CapacityBarViewModel(ds.UsagePercent, CapacityBarSize.Regular, ShowPercentage: false)" />
        </div>
        <div class="row g-3 small">
            <div class="col-6 col-md-3">
                <div class="text-body-secondary">Used</div>
                <div class="fw-semibold">@ds.Used.FormatBytes()</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-body-secondary">Available</div>
                <div class="fw-semibold">@ds.Avail.FormatBytes()</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-body-secondary">Referenced</div>
                <div class="fw-semibold">@ds.Refer.FormatBytes()</div>
            </div>
            @if (ds.UsedBySnapshots > 0)
            {
                <div class="col-6 col-md-3">
                    <div class="text-body-secondary">Snapshots</div>
                    <div class="fw-semibold">@ds.UsedBySnapshots.FormatBytes()</div>
                </div>
            }
        </div>
    </div>
</div>

@* ── Properties ──────────────────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-body bg-surface">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-gear text-info"></i>
            Properties
        </h5>
        <div class="row">
            <div class="col-md-6">
                <partial name="_KeyValueRows"
                        model="@(new KeyValueRowViewModel[]
                        {
                            new("Compression", $"{ds.Compression} ({ds.CompRatio})"),
                            new("Record Size", ds.RecordSize > 0 ? ds.RecordSize.FormatBytes() : "inherit"),
                            new("Dedup", ds.Dedup),
                            new("Sync", ds.Sync),
                            new("Case Sensitivity", ds.CaseSensitivity, Last: true),
                        })" />
            </div>

            <div class="col-md-6">
                <partial name="_KeyValueRows"
                        model="@(new KeyValueRowViewModel[]
                        {
                            new("Mountpoint", ds.Mountpoint),
                            new("CanMount", ds.CanMount),
                            new("Quota", ds.Quota.FormatBytesOrNone()),
                            new("RefQuota", ds.RefQuota.FormatBytesOrNone()),
                            new("Refreservation", ds.Refreservation.FormatBytesOrNone(), Last: true),
                        })" />
            </div>
        </div>
        @if (ds.Encrypted)
        {
            <div class="mt-2 small">
                <span class="text-body-secondary">Encryption:</span> @ds.EncryptionAlgorithm
                <span class="badge @(ds.KeyLocked ? "text-bg-warning" : "text-bg-success") ms-1">@(ds.KeyLocked ? "locked" : "loaded")</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(ds.Comment))
        {
            <div class="mt-2 small"><strong>Comment:</strong> @ds.Comment</div>
        }
    </div>
</div>

@* ── Snapshots ───────────────────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-body bg-surface">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-camera text-info"></i>
            Snapshots
            <span class="badge bg-body-tertiary text-body-secondary border ms-auto">@Model.SnapshotTable.Rows.Count</span>
        </h5>
        <partial name="_SnapshotTable" model="Model.SnapshotTable" />
    </div>
</div>

<partial name="_CommandSuggestions" model="new CommandSuggestionsViewModel(Model.Suggestions)" />
