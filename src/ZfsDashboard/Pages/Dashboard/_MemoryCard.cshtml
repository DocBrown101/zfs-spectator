@model MemoryCardViewModel
<div class="card mb-4">
    <div class="card-body bg-surface">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-memory text-info"></i>
            Memory
        </h5>
        <div class="d-flex align-items-center gap-4">
            <div class="position-relative flex-shrink-0">
                <canvas id="memCanvas" data-initial-value="@Model.UsagePercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"></canvas>
                <div class="position-absolute top-50 start-50 translate-middle text-center">
                    <span class="fw-bold fs-5" id="memPct">@Model.UsagePercent.ToString("F1")%</span>
                </div>
            </div>
            <div class="flex-grow-1">
                <partial name="/Pages/Shared/_KeyValueRows.cshtml" model="Model.Details" />
            </div>
        </div>
    </div>
</div>
