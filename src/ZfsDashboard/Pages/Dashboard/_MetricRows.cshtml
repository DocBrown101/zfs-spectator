@model IReadOnlyList<MetricRowViewModel>
@for (var i = 0; i < Model.Count; i++)
{
    var row = Model[i];
    var border = i == Model.Count - 1 ? "" : "border-bottom border-secondary";
    var visibility = row.IsVisible ? "" : "d-none";
    <div class="row py-2 @border small @visibility" data-metric-row>
        <div class="col-5 text-body-secondary">@row.Label</div>
        <div class="col-7 @row.ValueCss" id="@row.ElementId">@row.Value</div>
    </div>
}
