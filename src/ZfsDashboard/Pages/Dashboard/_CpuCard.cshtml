@model CpuCardViewModel
<div class="card mb-4">
    <div class="card-body bg-surface">
        <h5 class="card-title d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-cpu text-info"></i>
            CPU
        </h5>
        <div class="d-flex align-items-center gap-4">
            <div class="position-relative flex-shrink-0 dashboard-gauge">
                <canvas id="cpuCanvas" data-initial-value="@Model.UsagePercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"></canvas>
                <div class="position-absolute top-50 start-50 translate-middle text-center">
                    <span class="fw-bold fs-5" id="cpuPct">@Model.UsagePercent.ToString("F1")%</span>
                </div>
            </div>
            <div class="flex-grow-1">
                <partial name="/Pages/Dashboard/_MetricRows.cshtml" model="Model.Details" />
            </div>
        </div>
    </div>
</div>
